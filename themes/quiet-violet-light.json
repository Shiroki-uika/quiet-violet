  "tokenColors": [
    {
      "name": "Default / embedded",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.jsx.children"
      ],
      "settings": {
        "foreground": "#333333",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#969896",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#A71D5D",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A71D5D",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#A71D5D",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#333333",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#795DA3",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions / types",
      "scope": [
        "support.function",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Class titles",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#183691",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Literals",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.character"
      ],
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Language variables",
      "scope": "variable.language",
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Symbols",
      "scope": "constant.other.symbol",
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#183691",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#A71D5D",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#0086B3",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values",
      "scope": "support.constant.property-value",
      "settings": {
        "foreground": "#183691",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "markup.error"
      ],
      "settings": {
        "foreground": "#CC0000",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#705697",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#006699",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#183691",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#64616E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#333333",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#333333",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#64616E",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff addition (+)",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#24578A",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletion (-)",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#CF222E",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff change",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#705697",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#0086B3",
    "property": "#0086B3",
    "parameter": "#0086B3",
    "function": "#795DA3",
    "method": "#795DA3",
    "function.defaultLibrary": "#0086B3",
    "method.defaultLibrary": "#0086B3",
    "type": "#0086B3",
    "class": "#000000",
    "interface": "#000000",
    "enum": "#000000",
    "namespace": "#000000",
    "typeParameter": "#0086B3",
    "keyword": "#A71D5D",
    "modifier": "#A71D5D",
    "string": "#183691",
    "number": "#0086B3",
    "regexp": "#183691",
    "comment": "#969896",
    "operator": "#A71D5D",
    "enumMember": "#0086B3",
    "variable.readonly": "#0086B3",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
