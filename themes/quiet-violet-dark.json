  "tokenColors": [
    {
      "name": "Default / embedded",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "meta.jsx.children"
      ],
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#75715E",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": "keyword",
      "settings": {
        "foreground": "#F92672",
        "fontStyle": ""
      }
    },
    {
      "name": "Storage declarations",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#66D9EF",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#F92672",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#FD971F",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions / types",
      "scope": [
        "support.function",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": ""
      }
    },
    {
      "name": "Class titles",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": "string",
      "settings": {
        "foreground": "#E6DB74",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#BE84FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Literals",
      "scope": [
        "constant.language",
        "support.constant",
        "constant.character"
      ],
      "settings": {
        "foreground": "#BE84FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Language variables",
      "scope": "variable.language",
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Symbols",
      "scope": "constant.other.symbol",
      "settings": {
        "foreground": "#BE84FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#E6DB74",
        "fontStyle": ""
      }
    },
    {
      "name": "Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#F92672",
        "fontStyle": ""
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values",
      "scope": "support.constant.property-value",
      "settings": {
        "foreground": "#E6DB74",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "markup.error"
      ],
      "settings": {
        "foreground": "#FF6666",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C4B0DF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#3399FF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#E6DB74",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#B5ACBF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": "markup.italic",
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#F8F8F2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "foreground": "#B5ACBF",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Diff addition (+)",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#51A0C8",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deletion (-)",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#DC5A5A",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff change",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#C4B0DF",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#FFFFFF",
    "property": "#FFFFFF",
    "parameter": "#FD971F",
    "function": "#A6E22E",
    "method": "#A6E22E",
    "function.defaultLibrary": "#A6E22E",
    "method.defaultLibrary": "#A6E22E",
    "type": "#A6E22E",
    "class": "#A6E22E",
    "interface": "#A6E22E",
    "enum": "#A6E22E",
    "namespace": "#A6E22E",
    "typeParameter": "#A6E22E",
    "keyword": "#F92672",
    "modifier": "#66D9EF",
    "string": "#E6DB74",
    "number": "#BE84FF",
    "regexp": "#E6DB74",
    "comment": "#75715E",
    "operator": "#F92672",
    "enumMember": "#BE84FF",
    "variable.readonly": "#FFFFFF",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
